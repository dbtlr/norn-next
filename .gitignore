# Machine-local editor/agent binding config: names a per-machine knowledge
# store, so it is intentionally untracked and differs per checkout. Its sibling
# .mimir.toml IS tracked, because the project binding is repo-durable.
.atlas.toml

.DS_Store
/target
*.local.md
*.local.json

# In-repo worktree checkouts (worktrunk layout)
/.worktrees/

# The scheduled lanes write their certification suite logs here.
certification-logs/

# The qualification record a lane emits, where a local run names a sink.
qualification-record.json
